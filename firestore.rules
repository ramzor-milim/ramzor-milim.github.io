rules_version = '2';
// Firestore security rules for Ramzor Milim (published in the Firebase console).
// The Firebase web config in index.html is public by design; these rules are what protect the data.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.uid == '0Nr9yU1s9PbYWfDvRRYHWjMF1H42'; }
    function active() { return signedIn() && !exists(/databases/$(database)/documents/bans/$(request.auth.uid)); }

    // banned users (admin only; a user may check their own ban)
    match /bans/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // login details per user, readable only by the admin
    match /profiles/{uid} {
      allow read: if isAdmin();
      allow create, update: if active() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['login', 'kind', 'name', 't']) && request.resource.data.login is string && request.resource.data.login.size() <= 120 && request.resource.data.kind in ['username', 'google', 'email'] && request.resource.data.name is string && request.resource.data.name.size() <= 80 && request.resource.data.t is number;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // admin dashboard: all published associations
    match /{path=**}/notes/{noteId} {
      allow read: if isAdmin();
    }

    // each user's private progress
    match /users/{uid}/{doc=**} {
      allow read, write: if active() && request.auth.uid == uid;
    }

    match /members/{uid} {
      allow read: if true;
      allow create, update: if active() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['t']) && request.resource.data.t is number;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /noteIndex/{noteId} {
      allow read: if true;
      allow create: if active() && request.resource.data.keys().hasOnly(['uid', 't']) && request.resource.data.uid == request.auth.uid && request.resource.data.t is number;
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
    }

    // shared associations per word
    match /shared/{lang}/words/{word}/notes/{noteId} {
      function validLang() { return lang in ['en', 'he']; }
      function nd() { return request.resource.data; }
      function oldLikes() { return resource.data.get('likes', []); }
      function imgOk() { return !('img' in nd()) || (nd().img is string && nd().img.size() <= 160000 && nd().img.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')); }
      function textOk() { return nd().text is string && nd().text.size() <= 500 && (nd().text.size() > 0 || nd().get('img', '') != ''); }
      function renameOnly() { return nd().diff(resource.data).affectedKeys().hasOnly(['name']) && nd().name is string && nd().name.size() <= 40; }
      function transferOnly() { return nd().diff(resource.data).affectedKeys().hasOnly(['uid', 'name']) && nd().uid is string && nd().name is string && nd().name.size() <= 40; }
      function likeOnly() { return nd().diff(resource.data).affectedKeys().hasOnly(['likes']) && nd().likes is list && nd().likes.size() <= 5000 && nd().likes.toSet().difference(oldLikes().toSet()).hasOnly([request.auth.uid]) && oldLikes().toSet().difference(nd().likes.toSet()).hasOnly([request.auth.uid]); }
      allow read: if active() && validLang();
      allow create: if active() && validLang() && nd().keys().hasOnly(['uid', 'text', 'name', 't', 'img']) && nd().uid == request.auth.uid && textOk() && nd().name is string && nd().name.size() <= 40 && nd().t is number && imgOk();
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow update: if active() && ((resource.data.uid == request.auth.uid && (renameOnly() || transferOnly())) || (resource.data.uid != request.auth.uid && likeOnly()));
    }
  }
}
